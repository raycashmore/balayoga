              "layout": "vertical",
              "gap": 17,
              "padding": [
                38,
                52
              ],
              "children": [
                {
                  "type": "text",
                  "id": "XHAbP",
                  "name": "Article opening",
                  "fill": "#2F293D",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Does your daughter believe she can’t change her mental illness?",
                  "lineHeight": 1.2,
                  "fontFamily": "Cormorant Garamond",
                  "fontSize": 26,
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "J2ccho",
                  "name": "Article paragraph one",
                  "fill": "#4E4858",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Maybe she’s been given a diagnosis — and now that diagnosis defines her. The label has become how she sees herself, and it’s in control of everything she does.",
                  "lineHeight": 1.62,
                  "fontFamily": "Inter",
                  "fontSize": 14,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "c8EZCx",
                  "name": "Article paragraph two",
                  "fill": "#4E4858",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "She carries that diagnosis wherever she goes and builds an identity around it. But this is not the life you imagined for your daughter.",
                  "lineHeight": 1.62,
                  "fontFamily": "Inter",
                  "fontSize": 14,
                  "fontWeight": "normal"
                },
                {
                  "type": "frame",
                  "id": "A25Wl",
                  "name": "Continue reading",
                  "gap": 9,
                  "alignItems": "center",
                  "children": [
